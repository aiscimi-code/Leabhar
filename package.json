{
  "name": "leabhar",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first Irish accounting and tax preparation system",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
