# Local database file
DATABASE_PATH=./data/accounting.db

# Where original documents are stored. Never modified after ingest.
DOCUMENT_STORAGE_PATH=./storage/documents

# Where the manual "Refresh / Import bank data" action looks for new statements
BANK_IMPORT_WATCH_PATH=./storage/inbox

# Versioned backups
BACKUP_PATH=./backups

# Optional. Extraction falls back to the deterministic local extractor when unset.
# ANTHROPIC_API_KEY=
EXTRACTION_PROVIDER=local
